{
  "name": "@bagsfm/bags-cli",
  "version": "0.1.5",
  "description": "CLI for Bags API and SDK workflows — auth, trading, launches, fees, and config",
  "type": "module",
  "bin": {
    "bags": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "start": "node dist/index.js",
    "bump": "node scripts/bump-version.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major"
  },
  "keywords": [
    "bags",
    "cli",
    "solana",
    "token-launch",
    "trading",
    "fees"
  ],
  "author": "bagsfm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagsfm/bags-cli.git"
  },
  "homepage": "https://github.com/bagsfm/bags-cli#readme",
  "bugs": {
    "url": "https://github.com/bagsfm/bags-cli/issues"
  },
  "dependencies": {
    "@bagsfm/bags-sdk": "^1.3.7",
    "@bagsfm/play-engine": "file:../play.bags/packages/engine",
    "@bagsfm/play-sdk": "file:../play.bags/packages/sdk",
    "@bagsfm/play-shared": "file:../play.bags/packages/shared",
    "@inquirer/prompts": "^8.4.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "hono": "4.12.9",
    "ora": "^9.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@types/node": "^25.5.2",
    "nats": "^2.29.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
